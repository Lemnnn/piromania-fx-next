# Quote form email delivery (https://resend.com). Without a key, development
# logs requests to the terminal and production shows an error with the phone number.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Piromania <site@piromania.ro>".
QUOTE_FROM_EMAIL=
# Where quote requests are delivered. Defaults to office@piromania.ro.
QUOTE_TO_EMAIL=
# Public origin of the site, used for canonical URLs, hreflang, sitemap and
# social previews. Defaults to https://piromania.ro.
NEXT_PUBLIC_SITE_URL=
